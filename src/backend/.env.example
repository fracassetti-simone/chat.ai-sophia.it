# ─── Server ───
NODE_ENV=development
PORT=4000
# Origine del frontend (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ─── Database (PostgreSQL) ───
# Con il docker-compose incluso: avvia `docker compose up -d db`
DATABASE_URL=postgresql://sophia:sophia@localhost:5432/sophia?schema=public

# ─── Auth ───
# Genera segreti robusti in produzione (es. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Bootstrap primo account (Super Admin) ───
BOOTSTRAP_ADMIN_EMAIL=simone@phi.it
BOOTSTRAP_ADMIN_PASSWORD=Ciao123!

# ─── OpenAI ───
OPENAI_API_KEY=
# Imposta qui l'esatta stringa modello fornita da OpenAI.
# Il codice è agnostico rispetto al modello: nessun nome è hardcoded.
OPENAI_MODEL=gpt-5.5

# ─── Upload ───
MAX_UPLOAD_MB=20

# ─── OTP WhatsApp (ai-sophia) ───
# Chiave API per inviare/verificare OTP via WhatsApp tramite otp.ai-sophia.it
# Ottenila dal pannello ai-sophia
OTP_API_KEY=

# ─── URL pubblico API (usato per snippet embed) ───
PUBLIC_API_URL=https://api.ai-sophia.it

# ─── Gemini AI ───
# La API key di Gemini NON va nel .env — si configura per ogni tenant
# nella pagina Moduli → Gemini AI → Configura (viene salvata nel database).
# Lascia questo commento come promemoria.
# GEMINI_API_KEY=  <-- NON USARE, configura dal pannello per tenant
